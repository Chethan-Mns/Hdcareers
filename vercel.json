{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "f=$(git diff --name-only HEAD^ HEAD); case \"$f\" in data/jobs.json|data/reel-selection.json|data/daily-review-batch.json|data/telegram-deliveries.json) exit 0;; *) exit 1;; esac",
  "rewrites": [
    {
      "source": "/api/admin/team",
      "destination": "/api/admin/session?adminOperation=team"
    },
    {
      "source": "/api/admin/audit",
      "destination": "/api/admin/session?adminOperation=audit"
    },
    {
      "source": "/api/admin/owner-password",
      "destination": "/api/admin/session?adminOperation=owner-password"
    },
    {
      "source": "/api/admin/android-devices",
      "destination": "/api/admin/session?adminOperation=android-devices"
    }
  ]
}
